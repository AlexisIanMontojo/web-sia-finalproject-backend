# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=
DB_PREFIX=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Xendit payments (configure these in Render, not in the frontend)
FRONTEND_URL=https://web-sia-finalproject-frontend.vercel.app
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
DOWNPAYMENT_PERCENT=30

# Optional external room-image storage (recommended for Render without a persistent disk)
# Set all three in the Render backend environment to enable Cloudinary uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=